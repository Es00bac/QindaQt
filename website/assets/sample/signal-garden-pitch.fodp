nt-size="45pt" fo:color="#91E0C7" style:font-name="DejaVu Sans" fo:font-weight="bold">feel alive.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s1-detail" draw:style-name="shape-s1-detail" svg:x="87pt" svg:y="383pt" svg:width="760pt" svg:height="57pt"><draw:text-box><text:p><text:span fo:font-size="19pt" fo:color="#E8F4EC" style:font-name="DejaVu Sans">A community light and sound evening</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s1-folio" draw:style-name="shape-s1-folio" svg:x="835pt" svg:y="489pt" svg:width="100pt" svg:height="26pt"><draw:text-box><text:p><text:span fo:font-size="12pt" fo:color="#91E0C7" style:font-name="DejaVu Sans" fo:font-weight="bold">01 / 04</text:span></text:p></draw:text-box></draw:frame><presentation:notes><draw:frame presentation:class="notes" svg:x="0pt" svg:y="0pt" svg:width="1pt" svg:height="1pt"><draw:text-box><text:p>Open with the courtyard as it is now, then describe the four stations that bring it to life.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="slide2" draw:master-page-name="paper" qq:title="The experience" qq:layout="title+content"><draw:frame draw:name="s2-rail" draw:style-name="shape-s2-rail" svg:x="46pt" svg:y="50pt" svg:width="10pt" svg:height="438pt"><draw:text-box><text:p><text:span fo:font-size="1pt" fo:color="#172F3D" style:font-name="DejaVu Sans" /></text:p></draw:text-box></draw:frame><draw:frame draw:name="s2-kicker" draw:style-name="shape-s2-kicker" svg:x="85pt" svg:y="66pt" svg:width="740pt" svg:height="31pt"><draw:text-box><text:p><text:span fo:font-size="15pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">SIGNAL GARDEN  /  02  /  THE EXPERIENCE</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s2-title-a" draw:style-name="shape-s2-title-a" svg:x="85pt" svg:y="164pt" svg:width="790pt" svg:height="66pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#172F3D" style:font-name="DejaVu Sans" fo:font-weight="bold">Four stops.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s2-title-b" draw:style-name="shape-s2-title-b" svg:x="85pt" svg:y="235pt" svg:width="790pt" svg:height="70pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">One shared night.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s2-detail" draw:style-name="shape-s2-detail" svg:x="87pt" svg:y="383pt" svg:width="760pt" svg:height="57pt"><draw:text-box><text:p><text:span fo:font-size="19pt" fo:color="#172F3D" style:font-name="DejaVu Sans">Light trail / Maker talks / Live demo / Take-home kit</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s2-folio" draw:style-name="shape-s2-folio" svg:x="835pt" svg:y="489pt" svg:width="100pt" svg:height="26pt"><draw:text-box><text:p><text:span fo:font-size="12pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">02 / 04</text:span></text:p></draw:text-box></draw:frame><presentation:notes><draw:frame presentation:class="notes" svg:x="0pt" svg:y="0pt" svg:width="1pt" svg:height="1pt"><draw:text-box><text:p>Walk the audience through timed entry, the accessible route, and where guests meet makers.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="slide3" draw:master-page-name="night" qq:title="The plan" qq:layout="title+content"><draw:frame draw:name="s3-rail" draw:style-name="shape-s3-rail" svg:x="46pt" svg:y="50pt" svg:width="10pt" svg:height="438pt"><draw:text-box><text:p><text:span fo:font-size="1pt" fo:color="#E8F4EC" style:font-name="DejaVu Sans" /></text:p></draw:text-box></draw:frame><draw:frame draw:name="s3-kicker" draw:style-name="shape-s3-kicker" svg:x="85pt" svg:y="66pt" svg:width="740pt" svg:height="31pt"><draw:text-box><text:p><text:span fo:font-size="15pt" fo:color="#91E0C7" style:font-name="DejaVu Sans" fo:font-weight="bold">SIGNAL GARDEN  /  03  /  THE PLAN</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s3-title-a" draw:style-name="shape-s3-title-a" svg:x="85pt" svg:y="164pt" svg:width="790pt" svg:height="66pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#E8F4EC" style:font-name="DejaVu Sans" fo:font-weight="bold">320 guests.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s3-title-b" draw:style-name="shape-s3-title-b" svg:x="85pt" svg:y="235pt" svg:width="790pt" svg:height="70pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#91E0C7" style:font-name="DejaVu Sans" fo:font-weight="bold">$8,600 ceiling.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s3-detail" draw:style-name="shape-s3-detail" svg:x="87pt" svg:y="383pt" svg:width="760pt" svg:height="57pt"><draw:text-box><text:p><text:span fo:font-size="19pt" fo:color="#E8F4EC" style:font-name="DejaVu Sans">Timed entry keeps the route welcoming and the numbers clear.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s3-folio" draw:style-name="shape-s3-folio" svg:x="835pt" svg:y="489pt" svg:width="100pt" svg:height="26pt"><draw:text-box><text:p><text:span fo:font-size="12pt" fo:color="#91E0C7" style:font-name="DejaVu Sans" fo:font-weight="bold">03 / 04</text:span></text:p></draw:text-box></draw:frame><presentation:notes><draw:frame presentation:class="notes" svg:x="0pt" svg:y="0pt" svg:width="1pt" svg:height="1pt"><draw:text-box><text:p>The budget workbook currently projects 7,632 in costs and 10,120 in income.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="slide4" draw:master-page-name="paper" qq:title="The decision" qq:layout="title+content"><draw:frame draw:name="s4-rail" draw:style-name="shape-s4-rail" svg:x="46pt" svg:y="50pt" svg:width="10pt" svg:height="438pt"><draw:text-box><text:p><text:span fo:font-size="1pt" fo:color="#172F3D" style:font-name="DejaVu Sans" /></text:p></draw:text-box></draw:frame><draw:frame draw:name="s4-kicker" draw:style-name="shape-s4-kicker" svg:x="85pt" svg:y="66pt" svg:width="740pt" svg:height="31pt"><draw:text-box><text:p><text:span fo:font-size="15pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">SIGNAL GARDEN  /  04  /  THE DECISION</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s4-title-a" draw:style-name="shape-s4-title-a" svg:x="85pt" svg:y="164pt" svg:width="790pt" svg:height="66pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#172F3D" style:font-name="DejaVu Sans" fo:font-weight="bold">Build the route.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s4-title-b" draw:style-name="shape-s4-title-b" svg:x="85pt" svg:y="235pt" svg:width="790pt" svg:height="70pt"><draw:text-box><text:p><text:span fo:font-size="45pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">Back the makers.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s4-detail" draw:style-name="shape-s4-detail" svg:x="87pt" svg:y="383pt" svg:width="760pt" svg:height="57pt"><draw:text-box><text:p><text:span fo:font-size="19pt" fo:color="#172F3D" style:font-name="DejaVu Sans">Approve access and weather cover this Friday.</text:span></text:p></draw:text-box></draw:frame><draw:frame draw:name="s4-folio" draw:style-name="shape-s4-folio" svg:x="835pt" svg:y="489pt" svg:width="100pt" svg:height="26pt"><draw:text-box><text:p><text:span fo:font-size="12pt" fo:color="#B9572C" style:font-name="DejaVu Sans" fo:font-weight="bold">04 / 04</text:span></text:p></draw:text-box></draw:frame><presentation:notes><draw:frame presentation:class="notes" svg:x="0pt" svg:y="0pt" svg:width="1pt" svg:height="1pt"><draw:text-box><text:p>Ask for approval of the step-free route and covered power before deposits are sent.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page></office:presentation></office:body></office:document>
#
# ADR-0388: every <qindaqt/...> include in this tree must resolve inside the
# module that provides it. A target that forgets to link that module would
# otherwise fall back to the compiler's default system directories, where an
# installed QindaQt package keeps older copies of the same public headers; the
# object then disagrees with the libraries it links about class layout.
#
# AGENT-NOTE: the guard mirrors every public header of this tree, and every
# QindaQt header installed in the compiler's implicit system directories, as an
# #error stub in one directory passed with -isystem. GCC and Clang search -I
# directories first, then -isystem directories, then the standard system
# directories, so a correctly linked target never reaches a stub, while a
# missing link fails at compile time instead of using the installed copy.
# Turning the option on or off changes every compile command (one full rebuild).

option(QINDAQT_HEADER_ISOLATION
    "Fail any compile whose <qindaqt/...> include would resolve outside this tree" ON)
if(NOT QINDAQT_HEADER_ISOLATION OR MSVC)
    return()
endif()

set(QINDAQT_HEADER_ISOLATION_DIR "${PROJECT_BINARY_DIR}/qindaqt-header-isolation")

set(_qindaqt_isolated_headers)
file(GLOB_RECURSE _qindaqt_tree_headers LIST_DIRECTORIES false
    "${PROJECT_SOURCE_DIR}/src/*.h")
foreach(_header IN LISTS _qindaqt_tree_headers)
    if(_header MATCHES "/include/(qindaqt/.+)$")
        list(APPEND _qindaqt_isolated_headers "${CMAKE_MATCH_1}")
    endif()
endforeach()
# Headers that only an older installation still has (renamed or removed here)
# must not resolve either.
foreach(_system IN LISTS CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES CMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES)
    if(IS_DIRECTORY "${_system}/qindaqt")
        file(GLOB_RECURSE _qindaqt_installed LIST_DIRECTORIES false
            RELATIVE "${_system}" "${_system}/qindaqt/*")
        list(APPEND _qindaqt_isolated_headers ${_qindaqt_installed})
    endif()
endforeach()
list(REMOVE_DUPLICATES _qindaqt_isolated_headers)

foreach(_relative IN LISTS _qindaqt_isolated_headers)
    file(CONFIGURE OUTPUT "${QINDAQT_HEADER_ISOLATION_DIR}/${_relative}" CONTENT
"// Generated by cmake/QindaQtHeaderIsolation.cmake (ADR-0388); never edit.
#error \"<${_relative}> is not on this target's include path: link the target that provides it instead of compiling against an installed copy (ADR-0388).\"
")
endforeach()

add_compile_options("SHELL:-isystem ${QINDAQT_HEADER_ISOLATION_DIR}")
list(LENGTH _qindaqt_isolated_headers _qindaqt_isolated_count)
message(STATUS "QindaQt header isolation: ${_qindaqt_isolated_count} guarded headers")
unset(_qindaqt_isolated_count)
unset(_qindaqt_isolated_headers)
unset(_qindaqt_tree_headers)
unset(_qindaqt_installed)

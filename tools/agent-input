#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Deliver JSON-described pointer and keyboard input through the RemoteDesktop portal.

Usage: agent-input [--devices pointer,keyboard]

Each line on stdin is a JSON object with an "action" key. The session is opened
with one native desktop approval prompt (CreateSession → SelectDevices → Start).
Input is delivered only after the user approves. The session closes when stdin
closes or a {"action":"close"} event is received.

Supported actions:
  {"action":"move","dx":5.0,"dy":0.0}
  {"action":"press","button":"left"}   -- also "right","middle","side","extra"
  {"action":"release","button":"left"}
  {"action":"scroll","dx":0.0,"dy":3.0}
  {"action":"key_press","keysym":65}
  {"action":"key_release","keysym":65}
  {"action":"text","text":"hello"}
  {"action":"close"}

Exits 0 on normal close, 1 on portal denial or transport error.
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent
if str(TOOLS_DIR) not in sys.path:
    sys.path.insert(0, str(TOOLS_DIR))

import dbus.mainloop.glib
from gi.repository import GLib

from agent_input.events import EventError, dispatch_event, parse_event
from agent_input.portal_session import (
    DEVICE_KEYBOARD,
    DEVICE_POINTER,
    ApprovedInputSession,
)
from agent_input.stdin_reader import StdinReader


def _parse_devices(spec: str) -> int:
    flags = 0
    for part in spec.split(","):
        part = part.strip().lower()
        if part == "keyboard":
            flags |= DEVICE_KEYBOARD
        elif part == "pointer":
            flags |= DEVICE_POINTER
    return flags or (DEVICE_KEYBOARD | DEVICE_POINTER)


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--devices", default="pointer,keyboard",
        help="comma-separated device types (default: pointer,keyboard)",
    )
    args = parser.parse_args()

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    loop = GLib.MainLoop()

    state: dict = {"error": None}
    reader = StdinReader()

    def _on_stdin(fd: int, condition: GLib.IOCondition) -> bool:
        # AGENT-GUARD: Read available bytes before checking HUP. A closed pipe
        # can deliver both IN and HUP simultaneously; checking HUP first would
        # discard the final data chunk. Read, process, then honour EOF.
        try:
            data = os.read(fd, 65536)
        except OSError:
            data = b""

        lines: list[str] = []
        if data:
            lines.extend(reader.feed(data))
        if not data or (condition & GLib.IOCondition.HUP):
            lines.extend(reader.flush())

        for raw in lines:
            try:
                event = parse_event(raw)
            except EventError as exc:
                print(f"WARN: {exc}", file=sys.stderr)
                continue
            if not event:
                continue
            try:
                keep = dispatch_event(event, session)
            except EventError as exc:
                print(f"WARN: {exc}", file=sys.stderr)
                continue
            if not keep:
                session.close()
                return False

        if not data or (condition & GLib.IOCondition.HUP):
            session.close()
            return False
        return True

    def _on_ready() -> None:
        print("READY", file=sys.stderr, flush=True)
        # Install stdin watch only after approval so no events reach the portal
        # before the Start handshake succeeds.
        GLib.io_add_watch(
            sys.stdin.fileno(),
            GLib.IOCondition.IN | GLib.IOCondition.HUP,
            _on_stdin,
        )

    def _on_closed() -> None:
        loop.quit()

    def _on_error(msg: str) -> None:
        state["error"] = msg
        print(f"ERROR: {msg}", file=sys.stderr, flush=True)
        loop.quit()

    session = ApprovedInputSession(
        bus=bus,
        loop=loop,
        devices=_parse_devices(args.devices),
        on_ready=_on_ready,
        on_closed=_on_closed,
        on_error=_on_error,
    )
    session.start()
    loop.run()
    return 1 if state["error"] else 0


if __name__ == "__main__":
    raise SystemExit(main())

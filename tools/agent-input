#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Deliver JSON-described pointer and keyboard input through the RemoteDesktop portal.

Usage: agent-input [--devices pointer,keyboard]

Each line on stdin is a JSON object with an "action" key. The session is opened
with one native desktop approval prompt (CreateSession → SelectDevices → Start).
Input is delivered only after the user approves. The session closes when stdin
closes or a {"action":"close"} event is received.

Supported actions:
  {"action":"move","dx":5.0,"dy":0.0}
  {"action":"move_abs","stream":0,"x":100.0,"y":200.0}
  {"action":"press","button":"left"}   -- also "right","middle","side","extra"
  {"action":"release","button":"left"}
  {"action":"scroll","dx":0.0,"dy":3.0}
  {"action":"key_press","keysym":65}
  {"action":"key_release","keysym":65}
  {"action":"text","text":"hello"}
  {"action":"close"}
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

TOOLS_DIR = Path(__file__).resolve().parent
if str(TOOLS_DIR) not in sys.path:
    sys.path.insert(0, str(TOOLS_DIR))

import dbus.mainloop.glib
from gi.repository import GLib

from agent_input.events import EventError, dispatch_event, parse_event
from agent_input.portal_session import (
    DEVICE_KEYBOARD,
    DEVICE_POINTER,
    ApprovedInputSession,
)


def _parse_devices(spec: str) -> int:
    flags = 0
    for part in spec.split(","):
        part = part.strip().lower()
        if part == "keyboard":
            flags |= DEVICE_KEYBOARD
        elif part == "pointer":
            flags |= DEVICE_POINTER
    return flags or (DEVICE_KEYBOARD | DEVICE_POINTER)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--devices", default="pointer,keyboard",
                        help="comma-separated device types (default: pointer,keyboard)")
    args = parser.parse_args()

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    loop = GLib.MainLoop()

    session = ApprovedInputSession(
        bus=bus,
        loop=loop,
        devices=_parse_devices(args.devices),
        on_ready=lambda: _ready(loop),
        on_closed=lambda: loop.quit(),
        on_error=lambda msg: _error_quit(msg, loop),
    )

    def _on_stdin(fd: int, condition: GLib.IOCondition) -> bool:
        if condition & GLib.IOCondition.HUP:
            session.close()
            return False
        line = os.read(fd, 4096).decode("utf-8", errors="replace")
        for raw_line in line.splitlines():
            try:
                event = parse_event(raw_line)
            except EventError as exc:
                print(f"WARN: {exc}", file=sys.stderr)
                continue
            if not event:
                continue
            if not dispatch_event(event, session):
                session.close()
                return False
        return True

    session.start()
    GLib.io_add_watch(sys.stdin.fileno(),
                      GLib.IOCondition.IN | GLib.IOCondition.HUP,
                      _on_stdin)
    loop.run()
    return 0


def _ready(loop: GLib.MainLoop) -> None:  # noqa: ARG001
    print("READY", file=sys.stderr, flush=True)


def _error_quit(msg: str, loop: GLib.MainLoop) -> None:
    print(f"ERROR: {msg}", file=sys.stderr, flush=True)
    loop.quit()


if __name__ == "__main__":
    raise SystemExit(main())

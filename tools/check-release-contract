#!/usr/bin/env python3
"""Fail closed when QindaQt release pins, packaging, or build output drift."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "compositor/upstream/kwin.json"
COMPOSITOR_DOC = ROOT / "docs/wiki/architecture/compositor-session.md"
ADR = ROOT / "docs/wiki/adr/0291-run-on-qindaqt-kwin.md"
OBJECT_ID = re.compile(r"[0-9a-f]{40}")
POWER_PROFILE_PROVIDER = re.compile(
    r"\|\|\s*\(\s*"
    r"sys-apps/tuned\[ppd\]\s+"
    r"sys-power/power-profiles-daemon\s*\)",
    re.DOTALL,
)


class ContractError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ContractError(message)


def load_json(path: Path) -> dict[str, object]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ContractError(f"{path}: {error}") from error
    require(isinstance(document, dict), f"{path}: top level must be an object")
    return document


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        raise ContractError(f"{path}: {error}") from error


def verify_repository() -> tuple[str, str, str]:
    """Checks the qindaqt-kwin pin (ADR-0291); returns fork version, fork commit, upstream release."""
    manifest = load_json(MANIFEST)
    require(manifest.get("schemaVersion") == 2, "compositor manifest schema must be 2 (qindaqt-kwin)")
    upstream = manifest.get("upstream")
    fork = manifest.get("fork")
    require(isinstance(upstream, dict), "compositor manifest needs an upstream object")
    require(isinstance(fork, dict), "compositor manifest needs a fork object")
    release = upstream.get("release")
    commit = upstream.get("commit")
    require(isinstance(release, str), "KWin release must be a string")
    require(isinstance(commit, str) and OBJECT_ID.fullmatch(commit) is not None,
            "KWin commit must be a lowercase 40-character object ID")
    require(upstream.get("ref") == f"refs/tags/v{release}",
            "KWin release and ref disagree")
    version = fork.get("version")
    fork_commit = fork.get("commit")
    require(isinstance(version, str) and re.fullmatch(re.escape(release) + r"\.[1-9][0-9]*", version) is not None,
            "qindaqt-kwin version must be <KWin release>.<serial>")
    require(isinstance(fork_commit, str) and OBJECT_ID.fullmatch(fork_commit) is not None,
            "qindaqt-kwin commit must be a lowercase 40-character object ID")
    require(fork.get("package") == f"gui-wm/qindaqt-kwin-{release}_p{version.rsplit('.', 1)[1]}",
            "qindaqt-kwin package and version disagree")

    for path in (COMPOSITOR_DOC, ADR):
        contents = read_text(path)
        for field in (version, fork_commit, release, upstream.get("tagObject"), commit, upstream.get("tree")):
            require(isinstance(field, str) and field in contents,
                    f"{path}: pinned qindaqt-kwin metadata is stale")
    return version, fork_commit, release


def verify_desktop_ebuild(path: Path, version: str, release: str) -> None:
    """Checks the full-desktop ebuild that will ship this tree (QindaGentoo)."""
    ebuild = read_text(path)
    serial = version.rsplit(".", 1)[1]
    # AGENT-GUARD: the Plasma-free package consumes native services. Shared
    # KWayland/layer-shell client libraries and KDE Frameworks remain allowed.
    retired = ("kwin", "kdecoration", "kscreenlocker", "polkit-kde-agent",
               "plasma-activities", "plasma-workspace", "libplasma", "powerdevil",
               "xdg-desktop-portal-kde", "kglobalacceld", "knighttime", "spectacle")
    for name in retired:
        require(f"kde-plasma/{name}" not in ebuild,
                f"desktop ebuild depends on retired Plasma runtime: kde-plasma/{name}")
    require(re.search(rf"=gui-wm/qindaqt-kwin-{re.escape(release)}_p{serial}(?:-r[1-9][0-9]*)?:=", ebuild) is not None,
            "desktop ebuild must pin the exact fork release and rebuild on its subslot")
    required_fragments = (
        f"=kde-plasma/layer-shell-qt-{release}*:6",
        f"=kde-plasma/kwayland-{release}*:6",
        ">=kde-frameworks/kconfig-6.0:6=",
        ">=kde-frameworks/kidletime-6.0:6=",
        ">=kde-frameworks/kio-6.0:6=",
        ">=kde-frameworks/kservice-6.0:6=",
        "kde-misc/kio-fuse",
        "net-wireless/bluez",
        "sys-apps/xdg-desktop-portal",
        "sys-power/upower",
        "dev-libs/libei",
        "sys-auth/polkit",
        ">=sys-auth/qindaqt-lock-pam-1",
        "!gui-apps/qindaqt-apps",
        "-DQINDAQT_BUILD_KWIN_PLUGIN=ON",
        "-DQINDAQT_BUILD_SHELL=ON",
        "-DQINDAQT_BUILD_PRODUCTION_SHELL=ON",
        # AGENT-GUARD: ADR-0345 holds the shipped default OFF until physical
        # receipt qualification; resident Power1 is still required above.
        "-DQINDAQT_NATIVE_POWER_EXCLUSIVE=OFF",
        "-DBUILD_TESTING=OFF",
    )
    for fragment in required_fragments:
        require(fragment in ebuild, f"desktop ebuild misses release contract: {fragment}")
    # ADR-0289: QindaQt ships its own screenshot tool; the desktop package must
    # not pull Spectacle back in as a dependency of QindaQt itself.
    require("kde-plasma/spectacle" not in ebuild,
            "desktop ebuild must not depend on kde-plasma/spectacle (ADR-0289)")
    require(
        POWER_PROFILE_PROVIDER.search(ebuild) is not None,
        "desktop ebuild must accept tuned[ppd] or power-profiles-daemon as the Power Profiles provider",
    )
    require(re.search(r'QINDAQT_COMMIT="[0-9a-f]{40}"', ebuild) is not None,
            "desktop ebuild must fetch one immutable source commit")
    require("cmake_src_install" in ebuild,
            "desktop ebuild must install the complete production tree")


def verify_runtime(command: Path, expected_release: str, cmake_version: Path) -> None:
    require(command.is_file(), f"compositor command is missing: {command}")
    completed = subprocess.run(
        [str(command), "--version"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    detail = "\n".join(part.strip() for part in (completed.stderr, completed.stdout)
                       if part.strip())
    require(completed.returncode == 0, f"compositor version command failed: {detail}")
    verify_runtime_output(completed.stdout, completed.stderr, expected_release)
    config = read_text(cmake_version)
    require(f'set(PACKAGE_VERSION "{expected_release}")' in config,
            f"QindaQtKWin CMake package is not {expected_release} exactly: {cmake_version}")


def verify_runtime_output(stdout: str, stderr: str, expected_release: str) -> None:
    # qindaqt-kwin keeps the application name "kwin" (KF6GlobalAccel component,
    # ADR-0291) and reports its own fork version.
    require(stdout.strip() == f"kwin {expected_release}",
            f"runtime qindaqt-kwin must report {expected_release} exactly once on stdout, "
            f"got stdout={stdout.strip()!r}, stderr={stderr.strip()!r}")


def verify_build(build_root: Path) -> None:
    cache = read_text(build_root / "CMakeCache.txt")
    require("QINDAQT_BUILD_KWIN_PLUGIN:BOOL=ON" in cache,
            "release build did not enable the native qindaqt-kwin plugin")
    require("QINDAQT_BUILD_PRODUCTION_SHELL:BOOL=ON" in cache,
            "release build did not enable the production shell")
    plugin = build_root / "plugins/qindaqt-kwin/plugins/qindaqt_compositor.so"
    launcher = build_root / "src/session/qindaqt-wm"
    require(plugin.is_file() and plugin.stat().st_size > 0,
            f"native KWin plugin artifact is missing: {plugin}")
    require(launcher.is_file() and launcher.stat().st_size > 0,
            f"session launcher artifact is missing: {launcher}")


def verify_install(install_root: Path) -> None:
    required_commands = (
        "qindaqt-wm",
        "qindaqt-shell",
        "qindaqt-file-manager",
        "qindaqt-editor",
    )
    for name in required_commands:
        command = install_root / "bin" / name
        require(command.is_file() and command.stat().st_size > 0,
                f"full desktop install omitted {command}")

    required_plugins = (
        "qindaqt_compositor.so",
        "org.qindaqt.so",
        "libqindaqt_app_shellplugin.so",
        "libqindaqt_controls_qmlplugin.so",
        "libqindaqt_tokens_qmlplugin.so",
    )
    installed_files = {
        path.name for path in install_root.rglob("*") if path.is_file()
    }
    for name in required_plugins:
        require(name in installed_files,
                f"full desktop install omitted runtime plugin {name}")
    # AGENT-CONTRACT (ADR-0291): qindaqt-kwin loads plugins, decorations and
    # window switchers only from its own namespaces.
    for relative in ("qindaqt-kwin/plugins/qindaqt_compositor.so",
                     "qindaqt-kwin/decorations/org.qindaqt.so"):
        require(any(install_root.rglob(relative)), f"full desktop install puts {Path(relative).name} outside {relative}")
    require(any(install_root.rglob("qindaqt-kwin/tabbox/qindaqt/metadata.json")),
            "full desktop install omitted the qindaqt window switcher in qindaqt-kwin/tabbox")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--compositor", type=Path, help="installed qindaqt-kwin program")
    result.add_argument("--compositor-cmake-version", type=Path, help="QindaQtKWinConfigVersion.cmake")
    result.add_argument("--desktop-ebuild", type=Path, help="gui-wm/qindaqt-desktop ebuild to check")
    result.add_argument("--build-root", type=Path)
    result.add_argument("--install-root", type=Path)
    return result


def main() -> int:
    arguments = parser().parse_args()
    try:
        version, commit, release = verify_repository()
        if arguments.desktop_ebuild:
            verify_desktop_ebuild(arguments.desktop_ebuild, version, release)
        runtime_arguments = (arguments.compositor, arguments.compositor_cmake_version)
        require(all(runtime_arguments) or not any(runtime_arguments),
                "runtime verification needs both the compositor command and its CMake version file")
        if arguments.compositor and arguments.compositor_cmake_version:
            verify_runtime(arguments.compositor, version, arguments.compositor_cmake_version)
        if arguments.build_root:
            verify_build(arguments.build_root.resolve())
        if arguments.install_root:
            verify_install(arguments.install_root.resolve())
    except ContractError as error:
        print(f"check-release-contract: error: {error}", file=sys.stderr)
        return 1
    print(f"Release contract verified: qindaqt-kwin {version} at {commit} (KWin {release}).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

"""Publish allowlisted agent usage metrics; never read transcripts or settings."""
import argparse
import datetime
import json
import math
import os
import re
import sys
import tempfile

SCOPES = {"lifetime", "session", "context", "billing-period", "report-period", "unreported"}
KEYS = {"schemaVersion", "providerId", "source", "observedAt", "scope", "tokenScope",
        "costScope", "inputTokens", "outputTokens", "totalTokens", "reportedCostUsd", "quotaWindows"}
LABELS = {"five-hour", "seven-day", "daily", "weekly", "monthly", "primary", "secondary", "quota", "spend-limit"}

def pairs(items):
    result = {}
    for key, value in items:
        if key in result:
            raise ValueError("duplicate")
        result[key] = value
    return result

def numeric(value, maximum, integer=False):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError("number")
    if not math.isfinite(value) or not 0 <= value <= maximum or (integer and int(value) != value):
        raise ValueError("range")
    return value

def date(value):
    if not isinstance(value, str) or not value.endswith("Z"):
        raise ValueError("date")
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))

def validate(report, provider):
    if not isinstance(report, dict) or set(report) - KEYS:
        raise ValueError("keys")
    if report.get("schemaVersion") != 1 or report.get("providerId") != provider:
        raise ValueError("identity")
    if report.get("source") not in {"claude-statusline", "provider-report", "manual-report"}:
        raise ValueError("source")
    for key in ("scope", "tokenScope", "costScope"):
        if report.get(key) not in SCOPES:
            raise ValueError("scope")
    if date(report.get("observedAt")) > datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(minutes=5):
        raise ValueError("future")
    for key in ("inputTokens", "outputTokens", "totalTokens"):
        if report.get(key) is not None:
            numeric(report[key], 2**53-1, True)
    if report.get("reportedCostUsd") is not None:
        numeric(report["reportedCostUsd"], 1e12)
    windows = report.get("quotaWindows", [])
    if not isinstance(windows, list) or len(windows) > 16:
        raise ValueError("windows")
    for window in windows:
        if not isinstance(window, dict) or set(window) - {"label", "usedPercent", "resetAt"} or window.get("label") not in LABELS:
            raise ValueError("window")
        if window.get("usedPercent") is not None:
            numeric(window["usedPercent"], 1000000 if window["label"] == "spend-limit" else 100)
        if window.get("resetAt") is not None:
            date(window["resetAt"])
    return report

def claude(raw):
    if not isinstance(raw, dict):
        raise ValueError("object")
    result = {"schemaVersion": 1, "providerId": "claude", "source": "claude-statusline",
              "observedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
              "scope": "report-period", "tokenScope": "context", "costScope": "session", "quotaWindows": []}
    context = raw.get("context_window") or {}
    cost = raw.get("cost") or {}
    limits = raw.get("rate_limits") or {}
    for source, target in (("total_input_tokens", "inputTokens"), ("total_output_tokens", "outputTokens")):
        if source in context and context[source] is not None:
            result[target] = context[source]
    # AGENT-GUARD: These counts describe context, not cumulative session totals.
    if cost.get("total_cost_usd") is not None:
        result["reportedCostUsd"] = cost["total_cost_usd"]
    for name, label in (("five_hour", "five-hour"), ("seven_day", "seven-day"), ("spend_limit", "spend-limit")):
        value = limits.get(name)
        if value is None:
            continue
        window = {"label": label}
        if value.get("used_percentage") is not None:
            window["usedPercent"] = value["used_percentage"]
        if value.get("resets_at") is not None:
            seconds = numeric(value["resets_at"], 253402300799, True)
            window["resetAt"] = datetime.datetime.fromtimestamp(seconds, datetime.timezone.utc).isoformat().replace("+00:00", "Z")
        result["quotaWindows"].append(window)
    return result

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", required=True)
    parser.add_argument("--claude-statusline", action="store_true")
    parser.add_argument("--directory")
    args = parser.parse_args()
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", args.provider) or args.provider == "codex":
        raise ValueError("provider")
    data = sys.stdin.buffer.read(65537)
    if len(data) > 65536:
        raise ValueError("size")
    raw = json.loads(data, object_pairs_hook=pairs, parse_constant=lambda _: (_ for _ in ()).throw(ValueError("constant")))
    if args.claude_statusline and args.provider != "claude":
        raise ValueError("provider")
    report = validate(claude(raw) if args.claude_statusline else raw, args.provider)
    base = args.directory or os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "qindaqt/agent-usage/reports")
    if os.path.islink(base):
        raise ValueError("directory")
    os.makedirs(base, mode=0o700, exist_ok=True)
    descriptor, path = tempfile.mkstemp(prefix=".report-", dir=base)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(report, output, allow_nan=False, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(path, os.path.join(base, args.provider + ".json"))
    finally:
        if os.path.exists(path):
            os.unlink(path)

if __name__ == "__main__":
    try:
        main()
    except (ValueError, TypeError, KeyError, AttributeError, OverflowError, OSError):
        print("Agent usage report rejected", file=sys.stderr)
        sys.exit(1)

{
  "schemaVersion": 1,
  "id": "windows-modern",
  "name": "Centered Taskbar",
  "description": "A 48-pixel bottom taskbar whose start button and task tiles stay centred, with a modern start panel: a search field over installed applications, a pinned grid, and the complete list behind All apps, and no advertising, promoted apps, web results, or account prompts. Widgets sit at the left and the status area at the right; menus stay in their windows.",
  "defaultTheme": "qinda-daylight",
  "workflow": {
    "overview": "task-view",
    "workspacePolicy": "static",
    "launcher": "centered-menu",
    "menu": "start-menu",
    "taskList": "grouped-icons",
    "globalMenu": false,
    "fileManager": "explorer"
  },
  "panels": [
    {
      "id": "centered-taskbar", "edge": "bottom", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 48, "length": 1.0,
      "applets": [
        {"id": "widgets", "plugin": "dashboard", "settings": {"zone": "start"}},
        {"id": "start", "plugin": "start-menu", "settings": {"zone": "center", "variant": "modern"}},
        {"id": "tasks", "plugin": "centered-task-list", "settings": {"zone": "center", "presentation": "centered", "grouping": "always"}},
        {"id": "status", "plugin": "system-status", "settings": {"zone": "end"}},
        {"id": "tray", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    }
  ],
  "desktop": {
    "applets": [
      {
        "id": "desktop-icons",
        "plugin": "desktop-icons",
        "settings": {"contextMenuStyle": "windows", "applicationsMenuModifier": "shift"}
      }
    ]
  }
}

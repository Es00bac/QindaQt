{
  "schemaVersion": 1,
  "id": "nextstep-inspired",
  "name": "Workspace Dock",
  "description": "A column of square tiles down the right edge: the menu tile on top, application and window tiles in the middle, workspace and utility tiles at the foot. No horizontal bar anywhere.",
  "defaultTheme": "qinda-paper",
  "workflow": {
    "overview": "dock-grid",
    "workspacePolicy": "static",
    "launcher": "tile-dock",
    "menu": "window-local",
    "taskList": "dock-tiles",
    "globalMenu": false
  },
  "panels": [
    {
      "id": "workspace-dock", "edge": "right", "layer": "above", "hideMode": "never",
      "alignment": "start", "rows": 1, "thickness": 72, "length": 0.62,
      "applets": [
        {"id": "applications", "plugin": "launcher", "settings": {"zone": "start"}},
        {"id": "apps", "plugin": "application-tiles", "settings": {"zone": "center"}},
        {"id": "tasks", "plugin": "task-list", "settings": {"zone": "center"}},
        {"id": "workspaces", "plugin": "workspace-tiles", "settings": {"zone": "end"}},
        {"id": "tray", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    }
  ]
}

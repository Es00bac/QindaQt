{
  "schemaVersion": 1,
  "id": "qindaqt",
  "name": "QindaQt",
  "description": "A calm command bar with a window-aware smart shelf.",
  "defaultTheme": "qinda-dark",
  "workflow": {
    "overview": "compact",
    "workspacePolicy": "static",
    "launcher": "smart-shelf",
    "menu": "global",
    "taskList": "grouped",
    "globalMenu": true
  },
  "panels": [
    {
      "id": "command-bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 30, "length": 1.0,
      "applets": [
        {"id": "brand", "plugin": "system-menu", "settings": {"zone": "start"}},
        {"id": "menu", "plugin": "global-menu", "settings": {"zone": "start"}},
        {"id": "workspaces", "plugin": "workspace-switcher", "settings": {"zone": "center"}},
        {"id": "status", "plugin": "system-status", "settings": {"zone": "end"}},
        {"id": "bluetooth", "plugin": "bluetooth", "settings": {"zone": "end"}},
        {"id": "power", "plugin": "power", "settings": {"zone": "end"}},
        {"id": "audio", "plugin": "audio", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "status-notifier", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    },
    {
      "id": "smart-shelf", "edge": "bottom", "layer": "above", "hideMode": "intelligent",
      "alignment": "center", "rows": 1, "thickness": 80, "length": 0.42,
      "applets": [
        {"id": "apps", "plugin": "launcher", "settings": {"zone": "center", "dockMode": true}},
        {"id": "pins", "plugin": "quick-launch", "settings": {"zone": "center", "dockMode": true}},
        {"id": "tasks", "plugin": "task-list", "settings": {"zone": "center", "dockMode": true}}
      ]
    }
  ]
}

{
  "schemaVersion": 1,
  "id": "minimal",
  "name": "Minimal",
  "description": "Nothing on screen until you ask for it: one hidden strip holding the command palette and four glyphs. No clock, no task buttons, no workspace switcher.",
  "defaultTheme": "qinda-glass-dark",
  "workflow": {
    "overview": "command-palette",
    "workspacePolicy": "dynamic",
    "launcher": "command-palette",
    "menu": "hidden",
    "taskList": "hidden",
    "globalMenu": false
  },
  "panels": [
    {
      "id": "command-strip", "edge": "top", "layer": "overlay", "hideMode": "always",
      "alignment": "center", "rows": 1, "thickness": 32, "length": 0.32,
      "applets": [
        {"id": "applications", "plugin": "launcher", "settings": {"zone": "start"}},
        {"id": "command", "plugin": "command-palette", "settings": {"zone": "center"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "status-notifier", "plugin": "status-notifier", "settings": {"zone": "end"}}
      ]
    }
  ]
}

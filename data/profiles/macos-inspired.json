{
  "schemaVersion": 1,
  "id": "macos-inspired",
  "name": "Menu and Dock",
  "description": "A 24-pixel global menu bar across the top and a centred dock whose painted shelf hugs only the tiles it holds, hiding itself when a window needs the room. The File Manager always leads the dock and the Trash always ends it. Desktop icons sit on the right.",
  "defaultTheme": "qinda-macos",
  "workflow": {
    "overview": "expose",
    "workspacePolicy": "dynamic",
    "launcher": "center-dock",
    "menu": "global",
    "taskList": "dock-indicators",
    "globalMenu": true,
    "fileManager": "finder"
  },
  "panels": [
    {
      "id": "global-bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 24, "length": 1.0,
      "applets": [
        {"id": "system-menu", "plugin": "system-menu", "settings": {"zone": "start"}},
        {"id": "menu", "plugin": "global-menu", "settings": {"zone": "start"}},
        {"id": "status-notifier", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "status", "plugin": "system-status", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    },
    {
      "id": "dock", "edge": "bottom", "layer": "overlay", "hideMode": "intelligent",
      "alignment": "center", "rows": 1, "thickness": 72, "length": 1.0,
      "applets": [
        {"id": "file-manager", "plugin": "quick-launch", "settings": {"zone": "center", "dockMode": true, "items": "file-manager"}},
        {"id": "applications", "plugin": "launcher", "settings": {"zone": "center", "dockMode": true}},
        {"id": "pins", "plugin": "quick-launch", "settings": {"zone": "center", "dockMode": true, "items": "others"}},
        {"id": "tasks", "plugin": "task-list", "settings": {"zone": "center", "dockMode": true}},
        {"id": "trash", "plugin": "quick-launch", "settings": {"zone": "center", "dockMode": true, "items": "trash"}}
      ]
    }
  ],
  "desktop": {
    "applets": [
      {
        "id": "desktop-icons",
        "plugin": "desktop-icons",
        "settings": {
          "placement": "right",
          "contextMenuStyle": "mac",
          "applicationsMenuModifier": "ctrl"
        }
      }
    ]
  }
}

{
  "schemaVersion": 1,
  "id": "unity-inspired",
  "name": "Command Rail",
  "description": "A 64-pixel left rail of big tiles that hides behind any window, and a top bar carrying the focused window's name, its menu, and the searchable HUD.",
  "defaultTheme": "qinda-dusk",
  "workflow": {
    "overview": "workspace-spread",
    "workspacePolicy": "static",
    "launcher": "left-rail",
    "menu": "global-hud",
    "taskList": "launcher-integrated",
    "globalMenu": true
  },
  "panels": [
    {
      "id": "menu-bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 28, "length": 1.0,
      "applets": [
        {"id": "active-app", "plugin": "active-application", "settings": {"zone": "start"}},
        {"id": "menu", "plugin": "global-menu", "settings": {"zone": "start"}},
        {"id": "hud", "plugin": "command-hud", "settings": {"zone": "center"}},
        {"id": "status", "plugin": "system-status", "settings": {"zone": "end"}},
        {"id": "status-notifier", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    },
    {
      "id": "launcher-rail", "edge": "left", "layer": "above", "hideMode": "dodge-all",
      "alignment": "fill", "rows": 1, "thickness": 64, "length": 1.0,
      "applets": [
        {"id": "applications", "plugin": "launcher", "settings": {"zone": "start"}},
        {"id": "pins", "plugin": "quick-launch", "settings": {"zone": "center"}},
        {"id": "tasks", "plugin": "task-list", "settings": {"zone": "center"}},
        {"id": "workspaces", "plugin": "workspace-switcher", "settings": {"zone": "end"}}
      ]
    }
  ]
}

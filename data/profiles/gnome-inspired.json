{
  "schemaVersion": 1,
  "id": "gnome-inspired",
  "name": "Overview",
  "description": "One top bar and nothing else: Activities, Applications and the focused app at the left, the clock centred, the status area at the right. Windows live in the overview, never on a task bar.",
  "defaultTheme": "qinda-slate",
  "workflow": {
    "overview": "activities",
    "workspacePolicy": "dynamic",
    "launcher": "overview-dash",
    "menu": "application-title",
    "taskList": "overview-only",
    "globalMenu": false
  },
  "panels": [
    {
      "id": "top-bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 38, "length": 1.0,
      "applets": [
        {"id": "activities", "plugin": "overview-trigger", "settings": {"zone": "start"}},
        {"id": "applications", "plugin": "launcher", "settings": {"zone": "start"}},
        {"id": "active-app", "plugin": "active-application", "settings": {"zone": "start"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "center"}},
        {"id": "status", "plugin": "system-status", "settings": {"zone": "end"}},
        {"id": "status-notifier", "plugin": "status-notifier", "settings": {"zone": "end"}},
        {"id": "clipboard", "plugin": "clipboard", "settings": {"zone": "end"}},
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}}
      ]
    }
  ]
}

    "crossAxis": {"minimum": 24, "preferred": 32, "maximum": 72, "stretch": false}
  },
  "capabilities": [
    "clipboard.read",
    "clipboard.write"
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

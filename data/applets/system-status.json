{
  "schemaVersion": 1,
  "id": "system-status",
  "name": "System Status",
  "description": "Aggregates the sound, Bluetooth, and power applet facades into one compact indicator with quick controls.",
  "apiVersion": "1.0",
  "entryPoint": {
    "kind": "builtin",
    "value": "qindaqt.applets.system-status"
  },
  "placements": {
    "zones": [
      "panel-start",
      "panel-center",
      "panel-end"
    ],
    "orientations": [
      "horizontal",
      "vertical"
    ]
  },
  "sizing": {
    "mainAxis": {
      "minimum": 32,
      "preferred": 96,
      "maximum": 200,
      "stretch": false
    },
    "crossAxis": {
      "minimum": 24,
      "preferred": 32,
      "maximum": 72,
      "stretch": false
    }
  },
  "capabilities": [
    "audio.read",
    "audio.control",
    "bluetooth.read",
    "bluetooth.control",
    "power.read",
    "power.control"
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

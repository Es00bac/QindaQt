{
  "schemaVersion": 1,
  "id": "smart-lights",
  "name": "Smart Lights",
  "description": "Finds Wiz smart lights on the local network, shows what each luminaire can actually do, and offers policy-gated power, brightness, white temperature, colour, scene, and saved-arrangement controls.",
  "apiVersion": "1.0",
  "entryPoint": {
    "kind": "builtin",
    "value": "qindaqt.applets.smart-lights"
  },
  "placements": {
    "zones": ["panel-start", "panel-center", "panel-end"],
    "orientations": ["horizontal", "vertical"]
  },
  "sizing": {
    "mainAxis": {"minimum": 32, "preferred": 50, "maximum": 140, "stretch": false},
    "crossAxis": {"minimum": 24, "preferred": 32, "maximum": 72, "stretch": false}
  },
  "capabilities": ["smart-lights.read", "smart-lights.control"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

{
  "schemaVersion": 1,
  "id": "voice",
  "name": "Voice",
  "description": "Shows bounded org.qindaqt.Voice1 dictation state and offers policy-gated push-to-talk, delivery and last-dictation controls.",
  "apiVersion": "1.0",
  "entryPoint": {
    "kind": "builtin",
    "value": "qindaqt.applets.voice"
  },
  "placements": {
    "zones": ["panel-start", "panel-center", "panel-end"],
    "orientations": ["horizontal", "vertical"]
  },
  "sizing": {
    "mainAxis": {"minimum": 32, "preferred": 40, "maximum": 160, "stretch": false},
    "crossAxis": {"minimum": 24, "preferred": 32, "maximum": 72, "stretch": false}
  },
  "capabilities": ["voice.read", "voice.control"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

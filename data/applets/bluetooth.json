    "crossAxis": {"minimum": 24, "preferred": 32, "maximum": 72, "stretch": false}
  },
  "capabilities": ["bluetooth.read", "bluetooth.control"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

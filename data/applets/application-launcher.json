{
  "schemaVersion": 1,
  "id": "application-launcher",
  "name": "Rail Launcher",
  "description": "The application launcher as one large square tile at the head of a vertical rail, sized for a Unity-style 64-pixel launcher rather than a panel chip.",
  "apiVersion": "1.0",
  "entryPoint": {
    "kind": "builtin",
    "value": "qindaqt.applets.launcher"
  },
  "placements": {
    "zones": ["panel-start", "panel-center", "panel-end"],
    "orientations": ["horizontal", "vertical"]
  },
  "sizing": {
    "mainAxis": {"minimum": 48, "preferred": 64, "maximum": 96, "stretch": false},
    "crossAxis": {"minimum": 48, "preferred": 64, "maximum": 96, "stretch": false}
  },
  "capabilities": ["applications.launch"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "showRecent": {"type": "boolean", "default": true},
      "searchOnOpen": {"type": "boolean", "default": true},
      "presentation": {"type": "string", "enum": ["standard", "rail"], "default": "rail"}
    }
  }
}

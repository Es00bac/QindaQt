{
  "schemaVersion": 1,
  "id": "firewall",
  "name": "Firewall",
  "description": "Shows whether QindaFirewall's background watcher is running and, in plain English, whether anything is trying to get in. Read-only: it never blocks, allows, or changes a firewall rule.",

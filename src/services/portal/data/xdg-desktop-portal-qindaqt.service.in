[Unit]
Description=QindaQt XDG desktop portal appearance backend
Documentation=https://qindaqt.org/
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.qindaqt
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/xdg-desktop-portal-qindaqt
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
TasksMax=16
UMask=0077

[Install]
WantedBy=graphical-session.target

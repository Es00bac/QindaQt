[Unit]
Description=QindaQt Audio1 service
Documentation=https://qindaqt.org/
After=pipewire.service wireplumber.service

[Service]
Type=dbus
BusName=org.qindaqt.Audio1
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-audio-service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateDevices=true
# AGENT-NOTE: no PrivateTmp here. The QindaQt session runs its own session
# bus with the socket under /tmp, and PrivateTmp gives the unit a private
# tmpfs where that socket does not exist, so the service can never reach
# its constructing bus and fails to start entirely.
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
# The console persists its document under $XDG_CONFIG_HOME/qindaqt (ADR-0176);
# without this carve-out ProtectHome refuses the write and the console
# silently forgets itself on every restart.
ReadWritePaths=%h/.config/qindaqt
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=16
UMask=0077

[Install]
WantedBy=default.target

[Unit]
Description=QindaQt Audio1 service
Documentation=https://qindaqt.org/
After=pipewire.service wireplumber.service

[Service]
Type=dbus
BusName=org.qindaqt.Audio1
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-audio-service
Restart=on-failure
RestartSec=1s
# AGENT-NOTE: systemd's Type=dbus default TimeoutStartSec is 90s. On a
# private session bus (ADR-0170) the user manager never observes this unit
# acquiring BusName=, so it always waits out the full timeout before D-Bus
# activation replaces it with an unmanaged process. 20s bounds that noisy
# wait; it does not remove it -- the underlying Type=dbus/private-bus
# mismatch is ADR-0170's, not this unit's alone.
TimeoutStartSec=20
NoNewPrivileges=true
PrivateDevices=true
# AGENT-NOTE: no PrivateTmp here. The QindaQt session runs its own session
# bus with the socket under /tmp, and PrivateTmp gives the unit a private
# tmpfs where that socket does not exist, so the service can never reach
# its constructing bus and fails to start entirely.
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
# The console persists its document under $XDG_CONFIG_HOME/qindaqt (ADR-0176);
# without this carve-out ProtectHome refuses the write and the console
# silently forgets itself on every restart.
ReadWritePaths=%h/.config/qindaqt
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
# AGENT-NOTE: VBAN (ADR-0185) sends and receives on an AF_INET UDP socket;
# with only AF_UNIX allowed here, the unit's own sandbox silently dropped
# that socket -- a stream could be declared and the unit still ran, but no
# packet was ever sent or received, and nothing in the service log said why.
# AF_INET6 is included so a future IPv6 sender/receiver does not hit the same
# silent block; today's implementation only resolves and binds AF_INET.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=16
UMask=0077

[Install]
WantedBy=default.target

[Unit]
Description=QindaQt Network1 service
Documentation=https://qindaqt.org/
After=graphical-session.target

[Service]
Type=dbus
BusName=org.qindaqt.Network1
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-network-service
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateDevices=true
# AGENT-NOTE: no PrivateTmp here. The QindaQt session runs its own session
# bus with the socket under /tmp, and PrivateTmp gives the unit a private
# tmpfs where that socket does not exist, so the service can never reach
# its constructing bus and fails to start entirely.
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=24
UMask=0077

[Install]
WantedBy=default.target

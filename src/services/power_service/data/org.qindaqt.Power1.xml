<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/qindaqt/Power1">
  <interface name="org.qindaqt.Power1">
    <method name="GetSnapshot">
      <arg name="snapshot" type="(uttuuss(bbbbbbb)(bubduubdbxbxu)a((ts)ussbbduubddbdbxbxu)(sa(ss)a((ts)sss)s)a(ssss)a((ts)sbuuub)a((ts)sbuubuuus)(bsut))" direction="out"/>
    </method>
    <method name="SetProfile">
      <arg name="profileId" type="s" direction="in"/>
      <arg name="result" type="(uuttttss)" direction="out"/>
    </method>
    <method name="AcquireProfileHold">
      <arg name="profileId" type="s" direction="in"/>
      <arg name="applicationName" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="result" type="(uuttttss)" direction="out"/>
    </method>
    <method name="ReleaseProfileHold">
      <arg name="hold" type="(tt)" direction="in"/>
      <arg name="result" type="(uuttttss)" direction="out"/>
    </method>
    <method name="SetKeyboardBrightness">
      <arg name="device" type="(tt)" direction="in"/>
      <arg name="value" type="u" direction="in"/>
      <arg name="result" type="(uuttttss)" direction="out"/>
    </method>
    <signal name="Changed">
      <arg name="epoch" type="t"/>
      <arg name="revision" type="t"/>
    </signal>
  </interface>
</node>

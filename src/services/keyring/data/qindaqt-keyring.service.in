# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=QindaQt native Secret Service
PartOf=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/qindaqt-keyring
UMask=0077
RuntimeDirectory=qindaqt-keyring
RuntimeDirectoryMode=0700
LimitCORE=0
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

[Unit]
Description=QindaQt keyring peer control endpoint
PartOf=graphical-session.target

[Socket]
ListenStream=%t/qindaqt-keyring/control
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
Service=qindaqt-keyring.service

[Install]
WantedBy=graphical-session.target

# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Trusted QindaQt keyring for UID %i
BindsTo=user@%i.service
After=user@%i.service
StartLimitIntervalSec=30
StartLimitBurst=2

[Service]
Type=simple
User=%i
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/qindaqt-keyring-launch --uid %i
Environment=PATH=/usr/bin:/bin LANG=C.UTF-8
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH PYTHONPATH
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
Delegate=no
RestrictAddressFamilies=AF_UNIX
Restart=no

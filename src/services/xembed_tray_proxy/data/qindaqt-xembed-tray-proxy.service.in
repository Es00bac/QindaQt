[Unit]
Description=QindaQt XEmbed to StatusNotifier tray proxy
Documentation=https://qindaqt.org/
# The proxy serves Wine/Proton tray icons; it is part of the graphical
# session and needs the session's XWayland display.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-xembed-tray-proxy
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateDevices=true
# AGENT-NOTE: no PrivateTmp here. The QindaQt session runs its own session
# bus with the socket under /tmp, and PrivateTmp gives the unit a private
# tmpfs where that socket does not exist, so the service can never reach
# its constructing bus and fails to start entirely.
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=16
UMask=0077

# AGENT-CONTRACT: deliberately NO [Install] section. QindaQt never activates
# graphical-session.target, so `WantedBy=graphical-session.target` meant
# systemd never started this unit at all - the proxy shipped and nothing ran
# it, and `_NET_SYSTEM_TRAY_S0` stayed unowned. The session supervisor owns
# startup instead (`xembedTrayProxyExecutable`), for the same reason it owns
# PowerDevil and KGlobalAccel.
#
# Do not add one back. ADR-0229's failure policy exists because two trays
# fighting over one selection is worse than one missing icon, and one
# automatic owner is how that stays true. The unit is kept so the proxy can
# still be started by hand for debugging:
#   systemctl --user start qindaqt-xembed-tray-proxy

[Unit]
Description=QindaQt Clipboard1 volatile history service
Documentation=https://qindaqt.org/

[Service]
Type=dbus
BusName=org.qindaqt.Clipboard1
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-clipboard-host
Restart=on-failure
RestartSec=1s
# AGENT-NOTE: systemd's Type=dbus default TimeoutStartSec is 90s. On a
# private session bus (ADR-0170) the user manager never observes this unit
# acquiring BusName=, so it always waits out the full timeout before D-Bus
# activation replaces it with an unmanaged process. 20s bounds that noisy
# wait; it does not remove it -- the underlying Type=dbus/private-bus
# mismatch is ADR-0170's, not this unit's alone.
TimeoutStartSec=20
NoNewPrivileges=true
PrivateDevices=true
# AGENT-NOTE: no PrivateTmp here. The QindaQt session runs its own session
# bus with the socket under /tmp, and PrivateTmp gives the unit a private
# tmpfs where that socket does not exist, so the service can never reach
# its constructing bus and fails to start entirely.
ProtectClock=true
ProtectControlGroups=true
# AGENT-GUARD: `true` also hides /run/user and therefore the session-bus and
# Wayland sockets this user service must open. Read-only retains filesystem
# protection while allowing connections to those existing sockets.
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
TasksMax=16
UMask=0077

[Install]
WantedBy=default.target

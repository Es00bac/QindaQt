[Unit]
Description=QindaQt Clipboard1 volatile history service
Documentation=https://qindaqt.org/

[Service]
Type=dbus
BusName=org.qindaqt.Clipboard1
ExecStart=@KDE_INSTALL_FULL_BINDIR@/qindaqt-clipboard-host
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
# AGENT-GUARD: `true` also hides /run/user and therefore the session-bus and
# Wayland sockets this user service must open. Read-only retains filesystem
# protection while allowing connections to those existing sockets.
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
TasksMax=16
UMask=0077

[Install]
WantedBy=default.target

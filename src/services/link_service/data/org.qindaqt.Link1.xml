<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/qindaqt/Link1">
  <interface name="org.qindaqt.Link1">
    <method name="Devices"><arg name="json" type="s" direction="out"/></method>
    <method name="ConfirmPairing">
      <arg name="id" type="s" direction="in"/>
      <arg name="accept" type="b" direction="in"/>
    </method>
    <method name="Unpair"><arg name="id" type="s" direction="in"/></method>
    <method name="Ring"><arg name="id" type="s" direction="in"/></method>
    <method name="PendingPairings"><arg name="json" type="s" direction="out"/></method>
    <method name="ListenPort"><arg name="port" type="q" direction="out"/></method>
    <signal name="DevicesChanged"><arg name="json" type="s"/></signal>
    <signal name="PairingRequested">
      <arg name="id" type="s"/><arg name="name" type="s"/>
      <arg name="model" type="s"/><arg name="code" type="s"/>
    </signal>
  </interface>
  <interface name="org.qindaqt.Link1.Notifications">
    <method name="ListApps"><arg name="json" type="s" direction="out"/></method>
    <method name="SetAppMuted">
      <arg name="pkg" type="s" direction="in"/>
      <arg name="muted" type="b" direction="in"/>
    </method>
    <method name="Reply">
      <arg name="device" type="s" direction="in"/><arg name="key" type="s" direction="in"/>
      <arg name="action" type="s" direction="in"/><arg name="text" type="s" direction="in"/>
      <arg name="error" type="s" direction="out"/>
    </method>
    <method name="Current"><arg name="json" type="s" direction="out"/></method>
    <method name="Revision"><arg name="revision" type="u" direction="out"/></method>
    <signal name="CurrentChanged"><arg name="revision" type="u"/><arg name="item" type="s"/></signal>
    <signal name="ReplyFinished">
      <arg name="device" type="s"/><arg name="key" type="s"/>
      <arg name="action" type="s"/><arg name="error" type="s"/>
    </signal>
  </interface>
  <interface name="org.qindaqt.Link1.Setup">
    <method name="AdbDevices"><arg name="json" type="s" direction="out"/></method>
    <method name="SetupPhone">
      <arg name="serial" type="s" direction="in"/><arg name="report" type="s" direction="out"/>
    </method>
    <method name="SetupStatus">
      <arg name="serial" type="s" direction="in"/><arg name="report" type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.qindaqt.Link1.Focus">
    <!-- Shell only (ADR-0440). json: {"uuid","appId","title","revision"} or {} when unknown. -->
    <method name="Publish"><arg name="json" type="s" direction="in"/></method>
  </interface>
</node>

[Desktop Entry]
Type=Application
Name=QindaQt Settings
Comment=Configure QindaQt
Exec=qindaqt-settings
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;Qt;
StartupNotify=true
Actions=appearance;display;

[Desktop Action appearance]
Name=Appearance
Exec=qindaqt-settings --page appearance

[Desktop Action display]
Name=Display
Exec=qindaqt-settings --page display

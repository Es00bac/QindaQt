@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.11 COMPONENTS Core Gui)
find_dependency(PkgConfig)
pkg_check_modules(QINDAQT_APP_WM_WAYLAND_CLIENT REQUIRED IMPORTED_TARGET GLOBAL wayland-client)
include("${CMAKE_CURRENT_LIST_DIR}/QindaQtApplicationWindowManagementTargets.cmake")
check_required_components(QindaQtApplicationWindowManagement)

{
  "schemaVersion": 1,
  "id": "panel-visibility-proof",
  "name": "Panel visibility proof",
  "description": "Installed nested proof fixture for always, window-aware, and auto-hide panels.",
  "defaultTheme": "qinda-dark",
  "workflow": {
    "overview": "compact",
    "workspacePolicy": "static",
    "launcher": "smart-shelf",
    "menu": "global",
    "taskList": "grouped",
    "globalMenu": true
  },
  "panels": [
    {
      "id": "always-bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 30, "length": 1.0,
      "applets": [
        {"id": "notifications", "plugin": "notification-center", "settings": {"zone": "end"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    },
    {
      "id": "window-rail", "edge": "left", "layer": "above", "hideMode": "intelligent",
      "alignment": "fill", "rows": 1, "thickness": 40, "length": 1.0,
      "applets": []
    },
    {
      "id": "auto-dock", "edge": "bottom", "layer": "above", "hideMode": "always",
      "alignment": "center", "rows": 1, "thickness": 48, "length": 0.36,
      "applets": [
        {"id": "apps", "plugin": "launcher", "settings": {"zone": "center"}}
      ]
    }
  ]
}

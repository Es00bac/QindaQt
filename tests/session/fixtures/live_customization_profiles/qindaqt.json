{
  "schemaVersion": 1,
  "id": "qindaqt",
  "name": "QindaQt live customization proof",
  "description": "A deterministic fixture for the live customization nested rows, shadowing the built-in default id through a private XDG data directory exactly as a distribution profile would: a top bar whose right half is empty panel material, a bottom tray, and a desktop-icons surface.",
  "defaultTheme": "qinda-dark",
  "workflow": {
    "overview": "compact",
    "workspacePolicy": "static",
    "launcher": "smart-shelf",
    "menu": "global",
    "taskList": "grouped",
    "globalMenu": true
  },
  "panels": [
    {
      "id": "bar", "edge": "top", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 30, "length": 1.0,
      "applets": [
        {"id": "launcher", "plugin": "launcher", "settings": {"zone": "start"}},
        {"id": "clock", "plugin": "clock", "settings": {"zone": "start"}}
      ]
    },
    {
      "id": "tray", "edge": "bottom", "layer": "above", "hideMode": "never",
      "alignment": "fill", "rows": 1, "thickness": 36, "length": 1.0,
      "applets": [
        {"id": "tray-clock", "plugin": "clock", "settings": {"zone": "end"}}
      ]
    }
  ],
  "desktop": {
    "applets": [
      {"id": "desktop-icons", "plugin": "desktop-icons", "settings": {}}
    ]
  }
}

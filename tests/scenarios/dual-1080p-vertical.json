{
  "$schema": "schema.json",
  "schema_version": 1,
  "id": "dual-1080p-vertical",
  "description": "Two 1080p outputs stacked vertically with the lower output primary.",
  "profile": "windows-modern",
  "theme": "qinda-dark",
  "outputs": [
    {
      "name": "DP-1",
      "enabled": true,
      "primary": false,
      "position": { "x": 0, "y": -1080 },
      "mode": { "width": 1920, "height": 1080, "refresh_hz": 60 },
      "scale": 1.0,
      "transform": "normal"
    },
    {
      "name": "DP-2",
      "enabled": true,
      "primary": true,
      "position": { "x": 0, "y": 0 },
      "mode": { "width": 1920, "height": 1080, "refresh_hz": 60 },
      "scale": 1.0,
      "transform": "normal"
    }
  ],
  "events": []
}
